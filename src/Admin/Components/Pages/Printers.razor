@page "/printers"
@attribute [Authorize(Policy = Roles.Admin)]
@inherits PageBase
@inject ModuleHost Modules
@inject PrinterService PrinterService
@inject DirectorySync Sync
@inject IInstalledPrinters Installed
@inject ModuleCatalog Catalog
@inject SettingsStore Settings
@inject ScanRelay.Core.Security.SecretProtector Protector
@inject AuditLog Audit

<PageTitle>Printers · ScanRelay</PageTitle>
<h1>Printers</h1>
<p class="lead">Add, edit or remove a printer. Test the connection, push a test entry, push the full list, or download the import file.</p>
<Messages Notice="@Notice" Error="@Error" />

@if (_form is null && !_adding)
{
    <div class="toolbar"><button class="primary" @onclick="StartAddAsync">Add a printer</button></div>

    @if (_printers.Count == 0)
    {
        <div class="panel muted">No printers yet.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Printer</th><th>Module</th><th>List</th><th>Last answered</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in _printers)
                    {
                        var module = Modules.Find(p.Printer.ModuleId);
                        <tr>
                            <td>@p.Printer.Name<div class="muted small">@p.Printer.Address · @p.Printer.Model</div></td>
                            <td>@p.Printer.ModuleId
                                @if (module is null) { <div><Badge Text="Not installed" Kind="bad" /></div> }
                                else if (!module.Usable) { <div><Badge Text="Paused" Kind="warn" /></div> }
                            </td>
                            <td>@p.Entries entries<div class="muted small">@(p.Printer.SyncGroupId is null ? "Default sync group" : $"Own group: {p.Printer.SyncGroupName ?? "chosen"}")</div></td>
                            <td>@Fmt.Ago(p.Printer.LastReachableUtc, NowUtc)</td>
                            <td class="actions">
                                <button class="small" disabled="@Busy" @onclick="() => TestAsync(p.Printer)">Test connection</button>
                                <button class="small" disabled="@Busy" @onclick="() => TestEntryAsync(p.Printer)">Push test entry</button>
                                <button class="small" disabled="@Busy" @onclick="() => PushNowAsync(p.Printer)">Push now</button>
                                <a class="button small" href="/files/printer/@p.Printer.Id/import">Import file</a>
                                <button class="small" disabled="@Busy" @onclick="() => Edit(p.Printer)">Edit</button>
                                @if (_removing == p.Printer.Id)
                                {
                                    <button class="small danger" disabled="@Busy" @onclick="() => RemoveAsync(p.Printer)">Confirm remove</button>
                                    <button class="small" @onclick="() => _removing = null">Keep</button>
                                }
                                else
                                {
                                    <button class="small danger" disabled="@Busy" @onclick="() => _removing = p.Printer.Id">Remove</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (_adding && _form is null)
{
    <h2>Printers installed on this server</h2>
    <p class="muted">These are the printers Windows knows about. The app does not scan the network.</p>
    @if (_installed.Count == 0)
    {
        <div class="panel muted">Windows reports no installed network printers on this server.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Name</th><th>Address</th><th>Model</th><th>Module</th><th></th></tr></thead>
                <tbody>
                    @{ var anyModule = Modules.Modules.Any(m => m.Usable); }
                    @foreach (var i in _installed)
                    {
                        var match = Modules.Match(i.Model).FirstOrDefault();
                        var onGitHub = match is null && _catalog?.Modules.Any(c => c.Covers(i.Model)) == true;
                        <tr>
                            <td>@i.Name</td><td>@i.Address</td><td>@i.Model</td>
                            <td>
                                @if (match is not null) { <Badge Text="@match.Id" Kind="ok" /> }
                                else if (onGitHub) { <span>A module exists on GitHub. Add it through the installer.</span> }
                                else if (anyModule) { <span class="muted">No module recognises this name. Windows often gives only the driver's name, not the model. If an installed module covers this printer, choose the module yourself.</span> }
                                else { <span class="muted">No module covers this model, so it cannot be added.</span> }
                            </td>
                            <td class="actions">
                                @if (match is not null) { <button class="small primary" @onclick="() => NewForm(i.Name, i.Address, i.Model, match.Id)">Choose</button> }
                                else if (anyModule) { <button class="small" @onclick="() => NewForm(i.Name, i.Address, string.Empty, Modules.Modules.First(m => m.Usable).Id)">Choose a module</button> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="toolbar" style="margin-top:14px">
        <button @onclick="() => NewForm(string.Empty, string.Empty, string.Empty, Modules.Modules.FirstOrDefault(m => m.Usable)?.Id)" disabled="@(!Modules.Modules.Any(m => m.Usable))">Add a printer by typing its address</button>
        <button @onclick="() => _adding = false">Cancel</button>
    </div>
    @if (!Modules.Modules.Any(m => m.Usable))
    {
        <div class="banner warn">No printer modules are installed. Run the installer on the server and open the Modules step.</div>
    }
}

@if (_form is not null)
{
    var data = Modules.Find(_form.ModuleId)?.Data;
    <h2>@(_form.Id == 0 ? "Add a printer" : $"Edit {_form.Name}")</h2>
    <div class="panel">
        <div class="field"><label for="p-name">Name</label><input id="p-name" type="text" @bind="_form.Name" /></div>
        <div class="field"><label for="p-address">Address</label><input id="p-address" type="text" @bind="_form.Address" />
            <div class="hint">The printer's host name or IP address.</div></div>
        <div class="field"><label for="p-model">Model</label><input id="p-model" type="text" @bind="_form.Model" /></div>
        <div class="field"><label for="p-module">Module</label>
            <select id="p-module" @bind="_form.ModuleId" @bind:after="ModuleChanged">
                @foreach (var m in Modules.Modules.Where(m => m.Usable))
                {
                    <option value="@m.Id">@m.Data!.Vendor @m.Data.Family (@m.Id)</option>
                }
            </select>
            @if (data is not null)
            {
                <div class="hint">Covers: @string.Join(", ", data.Models). @data.Method @(data.Unofficial ? "This method is not documented by the vendor." : "")
                    @if (data.Prerequisites.Count > 0) { <span>Install first: @string.Join(", ", data.Prerequisites).</span> }
                    @if (data.EntryLimit() is { } limit) { <span>Holds up to @limit people.</span> }
                </div>
            }
        </div>
        <h3>Values from the module</h3>
        <p class="hint">Change these only if this printer differs.</p>
        @foreach (var key in _form.Options.Keys.Where(k => !_form.Stored.ContainsKey(k)).Order().ToList())
        {
            <div class="field"><label for="opt-@key">@key.Replace('_', ' ')</label>
                @if (key == "protocol" && data is not null)
                {
                    <select id="opt-@key" value="@_form.Options[key]" @onchange="e => _form.Options[key] = e.Value?.ToString() ?? string.Empty">
                        @foreach (var p in data.Scan.Protocols) { <option value="@p">@p.ToUpperInvariant()</option> }
                    </select>
                }
                else if (key == "smb_version" && data is not null)
                {
                    <select id="opt-@key" value="@_form.Options[key]" @onchange="e => _form.Options[key] = e.Value?.ToString() ?? string.Empty">
                        @foreach (var v in data.Scan.SmbVersions) { <option value="@v">SMB @v</option> }
                    </select>
                }
                else
                {
                    <input id="opt-@key" type="text" value="@_form.Options[key]" @onchange="e => _form.Options[key] = e.Value?.ToString() ?? string.Empty" />
                }
            </div>
        }
        <h3>Printer's admin sign-in</h3>
        <div class="field"><label for="p-user">User name</label><input id="p-user" type="text" @bind="_form.AdminUser" autocomplete="off" /></div>
        <div class="field"><label for="p-pass">Password</label><input id="p-pass" type="password" @bind="_form.AdminPassword" autocomplete="new-password" placeholder="@(_form.HasPassword ? "Stored. Leave empty to keep it." : "")" />
            <div class="hint">Stored encrypted on the server and never shown again.</div></div>
        @if (PrinterService.Preparer(_form.ModuleId) is { } preparer)
        {
            <h3>Read from the printer</h3>
            <p class="hint">@preparer.PrepareHint</p>
            <div class="toolbar">
                <button disabled="@Busy" @onclick="PrepareAsync">@preparer.PrepareLabel</button>
                <span class="muted">@(_form.Stored.Count == 0 ? "Not read yet." : _form.Read ? "Read just now. Save to keep it." : "Read before and stored. Read again after changing the printer's address book by hand.")</span>
            </div>
        }
        <GroupPicker Label="This printer's own group (optional)" AllowNone="true" GroupId="_form.GroupId" GroupName="@_form.GroupName"
                     Hint="Leave empty and this printer lists everyone in the default sync group. Choose a group and it lists that group's members instead: the default group is left out for this printer. People added by hand to every printer are still included. Takes effect at the next sync."
                     Changed="g => { _form.GroupId = g?.Id; _form.GroupName = g?.DisplayName; }" />
        <div class="toolbar">
            <button class="primary" disabled="@Busy" @onclick="SaveAsync">Save</button>
            <button @onclick="() => { _form = null; _adding = false; }">Cancel</button>
        </div>
        @if (_form.Id == 0)
        {
            <p class="hint">After saving: test the connection, which shows the model the printer itself reports, so you can see the module fits. Then push a test entry, then the full list.</p>
        }
    </div>
}

@code {
    private sealed record Row(Printer Printer, int Entries);

    private sealed class Form
    {
        public int Id;
        public string Name = "";
        public string Address = "";
        public string Model = "";
        public string ModuleId = "";
        public string AdminUser = "";
        public string AdminPassword = "";
        public bool HasPassword;
        public Guid? GroupId;
        public string? GroupName;
        public Dictionary<string, string> Options = [];

        /// <summary>What the module read from the printer, encrypted. Kept as it is and never shown.</summary>
        public Dictionary<string, string> Stored = [];
        public bool Read;
    }

    private List<Row> _printers = [];
    private IReadOnlyList<InstalledPrinter> _installed = [];
    private CatalogIndex? _catalog;
    private Form? _form;
    private bool _adding;
    private int? _removing;

    protected override async Task LoadAsync()
    {
        await using var db = await Db.CreateDbContextAsync();
        var printers = await db.Printers.AsNoTracking().OrderBy(p => p.Name).ToListAsync();
        var counts = await db.PrinterEntries.GroupBy(e => e.PrinterId).Select(g => new { g.Key, Count = g.Count() }).ToDictionaryAsync(x => x.Key, x => x.Count);
        _printers = [.. printers.Select(p => new Row(p, counts.GetValueOrDefault(p.Id)))];
    }

    private async Task StartAddAsync()
    {
        _adding = true;
        _installed = Installed.List();
        if (_catalog is null && (await Settings.GetAsync()).UpdateCheck)
        {
            try
            {
                _catalog = await Catalog.FetchAsync();
            }
            catch (ModuleException)
            {
                // GitHub cannot be reached. The list still shows what is installed.
            }
        }
    }

    private void NewForm(string name, string address, string model, string? moduleId)
    {
        _form = new Form { Name = name, Address = address, Model = model, ModuleId = moduleId ?? "" };
        ModuleChanged();
    }

    private void Edit(Printer p)
    {
        _form = new Form
        {
            Id = p.Id, Name = p.Name, Address = p.Address, Model = p.Model ?? "", ModuleId = p.ModuleId,
            AdminUser = p.AdminUser ?? "", HasPassword = p.AdminPasswordProtected is not null, GroupId = p.SyncGroupId,
            GroupName = p.SyncGroupId is null ? null : p.SyncGroupName ?? "Chosen group",
        };
        if (Modules.Find(p.ModuleId)?.Data is { } data) _form.Options = PrinterService.EffectiveOptions(p, data);
        _form.Stored = _form.Options.Where(o => o.Value.StartsWith(PrinterService.ProtectedPrefix, StringComparison.Ordinal)).ToDictionary(o => o.Key, o => o.Value);
    }

    private Task PrepareAsync() => DoAsync(async () =>
    {
        var f = _form!;
        if (string.IsNullOrWhiteSpace(f.Address)) return "Enter the printer's address first.";
        Printer? saved = null;
        if (f.Id != 0)
        {
            await using var db = await Db.CreateDbContextAsync();
            saved = await db.Printers.AsNoTracking().FirstOrDefaultAsync(p => p.Id == f.Id);
        }

        // The form as it stands, saved or not, with the stored password when none was typed.
        var printer = new Printer
        {
            Name = f.Name, Address = f.Address.Trim(), ModuleId = f.ModuleId,
            AdminUser = string.IsNullOrWhiteSpace(f.AdminUser) ? null : f.AdminUser.Trim(),
            AdminPasswordProtected = saved?.AdminPasswordProtected,
            OptionsJson = System.Text.Json.JsonSerializer.Serialize(f.Options),
        };
        var result = await PrinterService.PrepareAsync(printer, f.AdminPassword);
        if (!result.Succeeded) return result.Message ?? "The printer could not be read.";
        f.Stored = new(result.Values);
        f.Read = true;
        Notice = result.Message + " Save to keep it.";
        return null;
    }, null);

    private void ModuleChanged()
    {
        if (_form is null || Modules.Find(_form.ModuleId)?.Data is not { } data) return;
        _form.Options = PrinterService.EffectiveOptions(new Printer { Name = "", Address = "", ModuleId = data.Id }, data);
        _form.Stored = [];
        _form.Read = false;
    }

    private Task SaveAsync() => DoAsync(
        async () =>
        {
            var f = _form!;
            if (string.IsNullOrWhiteSpace(f.Name) || string.IsNullOrWhiteSpace(f.Address)) return "A printer needs a name and an address.";
            if (Modules.Find(f.ModuleId) is not { Usable: true } module) return "Choose an installed module.";
            await using var db = await Db.CreateDbContextAsync();
            if (await db.Printers.AnyAsync(p => p.Name == f.Name.Trim() && p.Id != f.Id)) return "Another printer already has that name.";
            var printer = f.Id == 0 ? null : await db.Printers.FindAsync(f.Id);
            if (printer is null)
            {
                printer = new Printer { Name = f.Name.Trim(), Address = f.Address.Trim(), ModuleId = f.ModuleId, CreatedUtc = NowUtc };
                db.Printers.Add(printer);
            }

            // Only values that differ from the module's own are stored, so a module update can change a default.
            var defaults = PrinterService.EffectiveOptions(new Printer { Name = "", Address = "", ModuleId = f.ModuleId }, module.Data!);
            var overrides = f.Options.Where(o => !f.Stored.ContainsKey(o.Key) && (!defaults.TryGetValue(o.Key, out var d) || d != o.Value)).ToDictionary(o => o.Key, o => o.Value);
            foreach (var (key, value) in f.Stored) overrides[key] = value;
            printer.Name = f.Name.Trim();
            printer.Address = f.Address.Trim();
            printer.Model = f.Model.Trim();
            printer.ModuleId = f.ModuleId;
            printer.SyncGroupId = f.GroupId;
            printer.SyncGroupName = f.GroupId is null ? null : f.GroupName;
            printer.AdminUser = string.IsNullOrWhiteSpace(f.AdminUser) ? null : f.AdminUser.Trim();
            printer.OptionsJson = System.Text.Json.JsonSerializer.Serialize(overrides);
            if (f.AdminPassword.Length > 0) printer.AdminPasswordProtected = Protector.ProtectBytes(f.AdminPassword);
            await db.SaveChangesAsync();
            await Audit.WriteAsync(Actor, f.Id == 0 ? "Printer added" : "Printer changed", printer.Name,
                $"{printer.Address}, module {printer.ModuleId}, {(printer.SyncGroupId is null ? "default sync group" : "own group " + printer.SyncGroupName)}");
            if (f.Read) await Audit.WriteAsync(Actor, "Printer read for its module", printer.Name);
            _form = null;
            _adding = false;
            return null;
        },
        "Saved. Test the connection, then push.");

    private Task TestAsync(Printer p) => DoAsync(async () =>
    {
        var probe = await PrinterService.ProbeAsync(p);
        if (!probe.Reachable) return $"{p.Name} did not answer. {probe.Error}";
        Notice = $"{p.Name} answered. Model: {probe.Model ?? "not reported"}. Firmware: {probe.Firmware ?? "not reported"}.";
        return null;
    }, null);

    private Task TestEntryAsync(Printer p) => DoAsync(async () =>
    {
        var outcome = await PrinterService.PushTestEntryAsync(p);
        await Audit.WriteAsync(Actor, "Test entry pushed", p.Name, outcome.Succeeded ? null : outcome.Error);
        if (!outcome.Succeeded) return $"The test entry could not be pushed to {p.Name}. {outcome.Error}";
        Notice = $"\"ScanRelay test\" is now on {p.Name}. Scan one page to it; it will show on the Jobs page as a test scan. The next push removes the entry.";
        return null;
    }, null);

    private Task PushNowAsync(Printer p) => DoAsync(async () =>
    {
        var runId = await Sync.PushPrinterAsync(p.Id, Actor);
        await using var db = await Db.CreateDbContextAsync();
        var push = await db.Pushes.Where(x => x.RunId == runId).FirstOrDefaultAsync();
        if (push is null)
        {
            var run = await db.Runs.FindAsync(runId);
            return DirectorySync.ReadDetail(run?.Detail).Message ?? "The push did not run.";
        }

        if (push.Status != PushStatus.Succeeded) return $"The push to {p.Name} failed. {push.Error}";
        Notice = $"Pushed to {p.Name}: {push.Added} added, {push.Updated} updated, {push.Removed} removed.";
        return null;
    }, null);

    private Task RemoveAsync(Printer p) => DoAsync(async () =>
    {
        // Take our entries off the printer first, so nothing is left pointing at a share it no longer uses.
        var cleared = await PrinterService.PushAsync(p, []);
        await using var db = await Db.CreateDbContextAsync();
        await db.Printers.Where(x => x.Id == p.Id).ExecuteDeleteAsync();
        await Audit.WriteAsync(Actor, "Printer removed", p.Name, cleared.Succeeded ? "Its entries were removed from the printer." : "Its entries could not be removed from the printer: " + cleared.Error);
        _removing = null;
        Notice = cleared.Succeeded
            ? $"{p.Name} was removed and its entries were taken off the printer."
            : $"{p.Name} was removed, but its entries could not be taken off the printer: {cleared.Error}";
        return null;
    }, null);
}
