@inherits LayoutComponentBase

<div class="shell">
    <nav class="nav" aria-label="Main">
        <div class="brand">ScanRelay</div>
        <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
        <NavLink href="/jobs">Jobs</NavLink>
        <NavLink href="/runs">Runs</NavLink>
        <AuthorizeView Roles="@Roles.Admin">
            <NavLink href="/printers">Printers</NavLink>
            <NavLink href="/people">People</NavLink>
            <NavLink href="/modules">Modules</NavLink>
            <NavLink href="/settings">Settings</NavLink>
            <NavLink href="/audit">Audit log</NavLink>
        </AuthorizeView>
        <div class="who">
            <AuthorizeView>
                <Authorized>
                    @if (context.User.HasClaim("setup", "true"))
                    {
                        <span>Setup, on this server</span>
                    }
                    else
                    {
                        <span>@context.User.Identity?.Name</span><br />
                        <a href="/signout">Sign out</a>
                    }
                </Authorized>
            </AuthorizeView>
        </div>
    </nav>
    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" style="display:none" class="banner bad">
    Something went wrong on this page. <a href="" class="reload">Reload</a>
</div>
